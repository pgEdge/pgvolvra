# volvra -- undo for Postgres
#
# This packaging is for SELF-HOSTED users only, as a convenience.  The
# supported install everywhere else is `psql -f sql/volvra.sql`, because
# CREATE EXTENSION needs filesystem access to the server -- which is exactly
# what managed providers do not give you, and exactly why volvra's core is
# plain SQL in the first place.
comment = 'Row-level undo and history for PostgreSQL'
# The *product* version, deliberately NOT coupled to volvra.schema_version,
# which is an internal migration counter -- see DECISIONS.md.
#
# Under semantic versioning a -beta sorts below 1.0.0, which is the GA these
# lead to.  Releasing as 1.x is a commitment: after GA, a breaking change to
# the public functions needs a major bump.
default_version = '1.0.0-beta2'
relocatable = false
superuser = false
trusted = false
